{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Augma DPS Meter",
	"mainBinaryName": "augma-dps-meter",
	"version": "0.1.0",
	"identifier": "fr.augma.dpsmeter",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "overlay",
				"title": "Augma DPS Meter",
				"width": 320,
				"height": 260,
				"minWidth": 220,
				"minHeight": 120,
				"maximizable": false,
				"decorations": false,
				"transparent": true,
				"shadow": false,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"focus": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installMode": "perMachine"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDREQ3MzlBMTM4ODU0NDcKUldSSFZJZ1RtblBkL0wyWFpaZCtjVEwvN3ZCNDRkM3d2eUNYNVJ6Qkp1OWcxRVhiY3VkMW1LOUwK",
			"endpoints": ["https://github.com/AugmaTV/AugmaDPSMeterAion2/releases/latest/download/latest.json"],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}