{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Augma DPS Meter",
	"mainBinaryName": "augma-dps-meter",
	"version": "0.8.1",
	"identifier": "fr.augma.dpsmeter",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "splash",
				"title": "Augma DPS Meter",
				"width": 360,
				"height": 180,
				"resizable": false,
				"maximizable": false,
				"decorations": false,
				"center": true,
				"theme": "Dark",
				"backgroundColor": "#0a0a0a"
			},
			{
				"label": "main",
				"title": "Augma DPS Meter",
				"width": 440,
				"height": 560,
				"minWidth": 340,
				"minHeight": 260,
				"visible": false,
				"theme": "Dark",
				"backgroundColor": "#0a0a0a"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"createUpdaterArtifacts": true,
		"resources": {
			"../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installMode": "perMachine",
				"installerHooks": "./windows/hooks.nsh"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDREQ3MzlBMTM4ODU0NDcKUldSSFZJZ1RtblBkL0wyWFpaZCtjVEwvN3ZCNDRkM3d2eUNYNVJ6Qkp1OWcxRVhiY3VkMW1LOUwK",
			"endpoints": ["https://github.com/AugmaTV/AugmaDPSMeterAion2/releases/latest/download/latest.json"],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}